# ============================================================
# Variables OBLIGATORIAS (application-prod.yml no define valor
# por defecto: la app falla al arrancar si faltan).
# En application-dev.yml todas tienen defaults de desarrollo,
# por lo que en dev este archivo es opcional.
# ============================================================
SPRING_PROFILES_ACTIVE=dev
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:XXXX/devdb
DB_USERNAME=username
DB_PASSWORD=password

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

JWT_SECRET=mySecretKey
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=fundamentos01-api

# ============================================================
# Variables OPCIONALES (tienen valor por defecto en
# application-prod.yml; solo aplican en prod)
# ============================================================
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=20000