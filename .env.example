# ============================================================
# Variables OBLIGATORIAS en perfil prod (application-prod.yml no
# define valor por defecto: la app falla al arrancar si faltan).
# En application-dev.yml todas tienen defaults de desarrollo,
# por lo que en dev este archivo es opcional.
# ============================================================
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=devdb
DB_USERNAME=username
DB_PASSWORD=password

JWT_SECRET=mySecretKey
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=fundamentos01-api

# ============================================================
# Variables OPCIONALES (tienen valor por defecto en
# application-prod.yml)
# ============================================================
PORT=8080
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
ROOT_LOG_LEVEL=WARN
APP_LOG_LEVEL=INFO
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=20000

# ============================================================
# Solo para desarrollo local fuera de Docker (application-dev.yml
# usa una URL JDBC completa en vez de DB_HOST/DB_PORT/DB_NAME)
# ============================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/pwp67_dev
